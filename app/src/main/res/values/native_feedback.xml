    <string name="native_dualsense_enabled">Native DualSense emulation</string>
    <string name="native_dualsense_enabled_summary">Report a connected DualSense as a native controller to compatible Apollo. Turn off for DualShock 4 compatibility; restart the game/stream after changing controller type.</string>
    <string name="dualsense_hd_frames_title">HD haptics frames per report</string>
    <string name="dualsense_hd_frames_summary">Two halve the number of Bluetooth writes. Choose one if there is no vibration at all.</string>
